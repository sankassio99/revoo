# Production (docker compose): public web config, baked at build time
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Path to Firebase Admin service account JSON on the VPS
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/service-account.json
# WEB_BIND=127.0.0.1
# WEB_PORT=3000

# Local development / emulators
FIREBASE_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-revoo-crm.firebaseapp.com
FIREBASE_PROJECT_ID=demo-revoo-crm
FIREBASE_APP_ID=demo-app-id
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
