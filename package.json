{
  "name": "revoo-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/domain",
    "test:rules": "firebase emulators:exec --project demo-revoo-crm --only firestore \"vitest run tests/security\"",
    "test:integration": "firebase emulators:exec --project demo-revoo-crm --only auth,firestore \"vitest run tests/integration\"",
    "test:e2e": "playwright test",
    "test:performance": "vitest run tests/performance",
    "test:recovery": "node scripts/verify-recovery.mjs",
    "emulators": "firebase emulators:start --project demo-revoo-crm --only auth,firestore",
    "check": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
