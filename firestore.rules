rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function isMember(tenantId) {
      return signedIn()
        && exists(memberPath(tenantId))
        && get(memberPath(tenantId)).data.status == 'active'
        && get(memberPath(tenantId)).data.role in ['owner', 'staff'];
    }

    function isOwner(tenantId) {
      return isMember(tenantId)
        && get(memberPath(tenantId)).data.role == 'owner';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /tenants/{tenantId} {
      allow get: if isMember(tenantId);
      allow list: if false;
      allow create, delete: if false;
      allow update: if isOwner(tenantId);

      match /members/{userId} {
        allow get: if isMember(tenantId) && (request.auth.uid == userId || isOwner(tenantId));
        allow list: if isOwner(tenantId);
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isOwner(tenantId);
        allow write: if false;
      }

      match /customers/{customerId} {
        allow read, create, update, delete: if isMember(tenantId);
      }

      match /services/{serviceId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isOwner(tenantId);
      }

      match /professionals/{professionalId} {
        allow read: if isMember(tenantId);
        allow create, update, delete: if isOwner(tenantId);
      }

      match /appointments/{appointmentId} {
        allow read, create, update, delete: if isMember(tenantId);
      }

      match /scheduleGuards/{professionalId} {
        allow read, write: if false;
      }

      match /campaigns/{campaignId} {
        allow read: if isMember(tenantId);
        allow write: if isOwner(tenantId);
      }

      match /messageLogs/{messageId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      match /settings/{document=**} {
        allow read: if isMember(tenantId);
        allow write: if isOwner(tenantId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
